# 复制为 config.yaml 后按需修改

api:
  # 内部核验接口地址（必填）
  url: "https://your-internal-api.example.com/verify"
  method: "POST"          # GET / POST / PUT
  timeout: 15             # 秒

  # 请求头（按需增删）
  headers:
    Content-Type: "application/x-www-form-urlencoded"
    User-Agent: "BatchVerify/1.0"
    # Authorization: "Bearer your_token_here"

  # 请求体字段映射：左侧为接口参数名，右侧为数据字段名
  payload_fields:
    realName: "realName"
    idCard: "idCard"

  # 额外固定参数（每条请求都会带上）
  extra_payload: {}

input:
  # 输入 TXT（本机路径）
  txt_path: "D:/batch-verify/input.txt"
  encoding: "utf-8"
  # 每行格式：姓名 身份证号（也支持逗号/制表符分隔）
  # delimiter: auto | comma | tab | space
  delimiter: "auto"
  # 首行是否为表头（如：姓名 身份证号）
  skip_header: false

output:
  # 结果输出到本机 D:\batch-verify\ 目录
  dir: "D:/batch-verify"
  # 结果文件：D:\batch-verify\result_时间戳.csv
  # 汇总文件：D:\batch-verify\result_时间戳_summary.json
  prefix: "result"

concurrency:
  workers: 8              # 线程数
  max_retries: 2          # 失败重试次数
  retry_delay: 1.0        # 重试间隔（秒）
  qps: 0                  # 限速，0 表示不限速

validation:
  # 请求前做本地身份证号格式校验，不合法则跳过 API 调用
  validate_id_card: true
