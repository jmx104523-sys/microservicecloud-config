BOT_TOKEN=123456:ABC-DEF...
# Bot 展示名
BOT_NAME=星弟搜索
# 启动时种子：搜索入口群（运行中可用 /add_search 追加）
ALLOWED_CHAT_IDS=-1001234567890
# 启动时种子：采集源群/频道（运行中可用 /add_source 追加；默认与 ALLOWED_CHAT_IDS 相同）
SOURCE_CHAT_IDS=-1001234567890,-1009876543210
# 管理员 user id（私聊可管理采集源/搜索入口/广告）
ADMIN_IDS=123456789
# 每页结果数
PAGE_SIZE=8
# SQLite 路径
DB_PATH=data/search.db
# 防失联链接（可选）
ANTI_LOST_URL=https://t.me/your_backup_channel
